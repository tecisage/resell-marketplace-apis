# Server Configuration
PORT=8090
ENV=development

# Database (PostgreSQL)
DB_URL=postgresql://user:password@localhost:5432/resell_db?sslmode=disable

# Authentication
JWT_SECRET=replace-with-a-secure-random-32-byte-secret

# Cloudflare R2 / S3-compatible Object Storage
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY=your-r2-access-key-id
R2_ACCESS_SECRET=your-r2-access-secret-key
R2_BUCKET=resell-apis

# CORS & Proxy Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
TRUSTED_PROXY_HEADER=
